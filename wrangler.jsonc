{
  // Zdalny MCP (YouTube Data API v3 + Supadata) na Cloudflare Workers Free.
  // Brak sekretów w tym pliku: klucze trafiają do `wrangler secret put` (patrz README.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Zmienne (nie sekrety). Trzymane tutaj, bo "wrangler deploy" nadpisuje zmienne z panelu Cloudflare. Limit Supadata: 300 (zmiana tylko za zgodą właściciela). Gemini: najwyżej 250 wywołań na dobę (ponowienia też), 2 równoległe, plan darmowy.
  "vars": {
    "SUPADATA_DAILY_CREDIT_BUDGET": "300",
    "GEMINI_DAILY_CALLS": "250",
    "GEMINI_CONCURRENCY": "2",
    // Limity planu Free z AI Studio → Rate limit (projekt research-firm, odczytane 2026-10-26); liczone także dla ponowień
    "GEMINI_MODEL_LIMITS": "{\"gemini-3.6-flash\":{\"rpm\":5,\"tpm\":250000,\"rpd\":20},\"gemini-3.8-flash\":{\"rpm\":5,\"tpm\":250000,\"rpd\":20},\"gemini-3.5-flash-lite\":{\"rpm\":15,\"tpm\":250000,\"rpd\":500},\"gemini-3.1-flash-lite\":{\"rpm\":15,\"tpm\":250000,\"rpd\":500}}"
  },

  // Wymagany przez bibliotekę OAuth (klienci, tokeny, zgody). Id uzupełnia `wrangler kv namespace create OAUTH_KV`.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "358f4ae16bc94f3bb45998bc9a8e3066" }],

  // Jedyna baza: Durable Object z SQLite (dostępny w planie Free): zadania, transkrypcje, cache, limity, eksporty.
  "durable_objects": { "bindings": [{ "name": "STORE", "class_name": "Store" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
