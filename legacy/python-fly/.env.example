# Wzór zmiennych środowiskowych. NIE wpisuj tu prawdziwych kluczy — ten plik jest bez sekretów.
# Na hostingu ustawiasz je przez `fly secrets set` (patrz README.md).
# Lokalnie możesz skopiować ten plik do `.env` i uzupełnić (`.env` jest w .gitignore).

# Publiczny adres aplikacji, https, bez ukośnika na końcu. Lokalnie wolno http://localhost:8080
PUBLIC_BASE_URL=https://TWOJA-APKA.fly.dev

# GitHub OAuth App. Callback URL w GitHubie: PUBLIC_BASE_URL + /auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Kto może korzystać z narzędzi: login GitHub LUB numeryczne ID (zalecane: ID nie zmienia się przy zmianie loginu;
# sprawdzisz je na https://api.github.com/users/TWOJ-LOGIN ), po przecinku.
ALLOWED_GITHUB_USERS=

# Klucz do podpisywania sesji, min. 32 znaki. Wygeneruj:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=

# Klucze API usług
YOUTUBE_API_KEY=
SUPADATA_API_KEY=

# --- Opcjonalne (w nawiasach wartości domyślne) ---
# Własne dzienne bezpieczniki, zanim zadziała limit usługi:
# YT_DAILY_UNIT_BUDGET=9000          (pula Google: 10 000 jednostek/dobę, reset o północy czasu pacyficznego)
# YT_DAILY_SEARCH_CALLS=100          (maks. wywołań search.list na dobę)
# YT_SEARCH_QUOTA_MODEL=shared       (shared = search kosztuje 100 jednostek ze wspólnej puli; separate = osobna pula wg nowszej dokumentacji Google)
# SUPADATA_DAILY_CREDIT_BUDGET=300   (kredyty Supadata na dobę UTC)
# YT_STATS_CACHE_SECONDS=3600
# YT_REQUEST_DELAY_SECONDS=0.25
# SUPADATA_DELAY_SECONDS=0.8
# SUPADATA_MIN_INTERVAL_SECONDS=0.3
# SUPADATA_MAX_TOTAL_TEXT_CHARS=80000
# ALLOWED_REDIRECT_URIS=             (domyślnie tylko adresy zwrotne claude.ai i claude.com)
# COLLECT_MAX_COUNT=500              (maks. Shortsów w jednym zadaniu zbierania)
# COLLECT_STEP_SECONDS=35            (budżet czasu jednego wywołania; Fly ucina bezczynne połączenia po 60 s)
# COLLECT_STEP_MAX_TRANSCRIPTS=40    (maks. pobrań transkrypcji w jednym wywołaniu)
# COLLECT_MAX_HISTORY=10000          (maks. filmów kanału przeglądanych przy oldest/most_viewed)
# COLLECT_RETENTION_DAYS=30          (jak długo przechowywać zadania i eksporty na wolumenie)
# EXPORT_LINK_TTL_SECONDS=86400      (ważność podpisanych linków do plików)
# LOG_LEVEL=INFO
# PORT=8080
# FASTMCP_HOME=/data/fastmcp
# MCP_CACHE_DIR=/data/cache
